# Application
APP_ENV=development
APP_NAME=LearnSphere AI
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=True

# Database (PostgreSQL + pgvector)
# Use asyncpg for async SQLAlchemy: postgresql+asyncpg://user:password@localhost:5432/learnsphere
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/learnsphere
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/learnsphere

# Supabase Auth & Storage (or local fallback)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=documents

# AI Provider Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSIONS=768

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Document Limits
MAX_UPLOAD_SIZE_MB=25
MAX_DOCUMENT_PAGES=500

